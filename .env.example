# ==============================================================================
# Environment Configuration
# Converted from: src/main/resources/application.properties
# ==============================================================================

# Application Environment (development, production, testing)
FLASK_ENV=development

# Application Secret Key (generate a secure random 32-byte hex for production)
SECRET_KEY=

# Database Configuration (MySQL / SQLAlchemy or SQLite)
# Corresponds to spring.datasource.url, username, password
DB_URL=mysql+pymysql://localhost:3306/library_management?charset=utf8mb4
DB_USERNAME=root
DB_PASSWORD=
# Or for local SQLite file:
# DATABASE_PATH=database.db

# Admin User Initialization
# Corresponds to library.admin.username & library.admin.password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session Cookie Security
# Corresponds to server.servlet.session.cookie.secure
SESSION_COOKIE_SECURE=false

# SQL Logging (true / false)
# Corresponds to spring.jpa.show-sql
SHOW_SQL=false
